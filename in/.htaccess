<IfModule mod_rewrite.c>
RewriteEngine On
RewriteOptions AllowNoSlash
<IfModule mod_dir.c>
DirectorySlash Off
</IfModule>

# Clean URLs apply only to this /in/ directory and its service pages.
# Keep POST requests and internal PHP rewrites intact.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php(?:[?\s]) [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ /%1 [R=301,L,NE]

RewriteRule ^blog-details/([A-Za-z0-9-]+)/?$ blog-details.php?slug=$1 [END,QSA]

# services.php and services/ coexist, so handle the listing before directories.
RewriteCond %{REQUEST_URI} ^(.*/in/services)/$
RewriteRule ^services/$ %1 [R=301,L,NE]
RewriteRule ^services$ services.php [END]

RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+[^/])$ $1.php [END]

# Preserve normal directory URLs and static assets.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>
